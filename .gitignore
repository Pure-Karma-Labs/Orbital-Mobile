# Dependencies
node_modules/
.yarn/

# React Native
ios/Pods/
ios/build/
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties

# Rust
rust/target/
rust/**/target/
packages/**/rust/**/target/

# uniffi-bindgen-react-native compiled binaries (rebuilt locally, not committed)
packages/**/build/
packages/**/android/src/main/jniLibs/

# Build artifacts
*.jsbundle
*.ipa
*.apk
*.aab
*.xcframework/
*.so

# Environment & secrets
.env
.env.*
!.env.example
!.env.smoke.android
!.env.smoke.ios
GoogleService-Info.plist
google-services.json
*.keystore
!android/app/debug.keystore
android/keystore.properties
*.jks
*.p12
*.mobileprovision
*.provisionprofile

# IDE
.vscode/
.idea/
**/*.xcworkspace/xcuserdata/
**/*.xcodeproj/xcuserdata/

# OS
.DS_Store
Thumbs.db

# Metro
.metro-health-check*

# Testing
coverage/

# Sentry (contains auth token for source map uploads)
**/sentry.properties

# Misc
*.log
*.tsbuildinfo

# Developer-machine overrides (leaks local paths/usernames)
ios/.xcode.env.local

# Firebase client config — injected from CI secrets, never commit
android/app/google-services.json
ios/OrbitalMobile/GoogleService-Info.plist

# Internal agent tooling config (removed from history at open-source flip)
.claude/

# Compliance material and store assets — never commit
# (store-listing.md is deliberately tracked; keep the negation below it)
project-docs/*
!project-docs/store-listing.md
/uploads/
docs/compliance/BIS Supplement*

# Swift Package Manager: the WORKSPACE Package.resolved is the committed Firebase pin (#769).
# Xcode also writes a project-scoped copy when the .xcodeproj is opened directly, and a
# per-user configuration dir under both; neither is a build input.
ios/OrbitalMobile.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
ios/OrbitalMobile.xcworkspace/xcshareddata/swiftpm/configuration/

# Kotlin 2.x compiler session cache (Gradle 9 toolchain)
android/.kotlin/

# NDK/CMake build caches (android/app/.cxx, packages/*/android/.cxx)
**/.cxx/
