# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Keep RNSentry on the source-built `Sentry` CocoaPod rather than the prebuilt
# Sentry.xcframework that @sentry/react-native 8.19.0 made the default.
#
# The xcframework path bakes the pod-install-time ABSOLUTE cache path
# (~/Library/Caches/sentry-react-native/...) into the pod's
# FRAMEWORK_SEARCH_PATHS. CocoaPods checksums a development pod by SHA1'ing the
# evaluated `Pods/Local Podspecs/RNSentry.podspec.json`, so that absolute path
# lands in SPEC CHECKSUMS — making the RNSentry checksum a function of $HOME.
# A lock generated on a dev Mac then never matches the one CI computes, and
# `pod install --deployment` fails for whoever didn't generate it.
#
# Opting out keeps `Sentry (9.19.1)` pinned in Podfile.lock (visible to
# dependency review) and keeps the lock reproducible across machines. Costs a
# source build of sentry-cocoa, which is what we did before 8.19.0 anyway.
# Override to '1' only for a local experiment — do not commit the lock it makes.
ENV['SENTRY_USE_XCFRAMEWORK'] ||= '0'
# Issue #667: keep Firebase on CocoaPods, not Swift Package Manager.
#
# @react-native-firebase >= 26 defaults to SPM on RN >= 0.75 (firebase_spm.rb):
# RNFBApp.podspec drops its `Firebase/CoreOnly` pod dependency and instead has
# `pod install` add an `XCRemoteSwiftPackageReference` (firebase-ios-sdk) plus an
# `XCSwiftPackageProductDependency` and two `[RNFB] ... SPM` shell phases to
# OrbitalMobile.xcodeproj, and force `-ObjC` / `*_ENABLE_EXPLICIT_MODULES=NO`
# onto every target. We opt out:
#   1. Notifee links FirebaseCore/FirebaseMessaging through CocoaPods, and
#      RNFB documents CocoaPods mode as REQUIRED when another pod shares
#      FirebaseCore (two copies = duplicate symbols / double configure).
#   2. The eight `:modular_headers => true` pins below have no SPM equivalent.
#   3. The pbxproj is committed and CI has no Archive step, so SPM resolution
#      churn would first be seen at release time.
# Must be exactly `true` (the podspec tests `== true`). Enforced by the
# post_install / post_integrate assertions at the bottom of this file, the
# ci.yml "Assert Firebase stays on CocoaPods" log check, and
# scripts/check-security-invariants.mjs #12.
# Horizon: Firebase stops publishing pods after October 2026 (DEBT-147/#637);
# the SPM migration belongs to that issue (#769), not this one.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'OrbitalMobile' do
  # Fail Release builds (incl. Product > Archive) if the vendored Rust
  # xcframework was not built with the release cargo profile. See issue #541.
  # Logic extracted to scripts/verify-rust-profile-ios.sh; unit-tested by
  # scripts/test-rust-profile-gate-ios.sh (issue #550).
  script_phase :name => '[Orbital] Verify Rust release profile',
    :script => 'exec bash "${SRCROOT}/../scripts/verify-rust-profile-ios.sh"',
    :execution_position => :before_compile,
    :always_out_of_date => '1'

  # Firebase requires modular headers for its Swift→ObjC interop
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 Clang falsely advertises consteval support but fails to compile it.
    # Patch fmt's base.h to force-disable consteval on all Apple Clang versions.
    # Tracking: https://github.com/facebook/react-native/issues/55601
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      patched = content.gsub(
        /defined\(__apple_build_version__\) && __apple_build_version__ < \d+L/,
        'defined(__apple_build_version__)'
      )
      if patched != content
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end

    # Issue #667 (guard 1 of 3 — resolved spec set): in CocoaPods mode the RNFB
    # podspecs declare the `Firebase/CoreOnly` and `Firebase/Messaging` umbrella
    # subspecs; in SPM mode they declare neither and pull Firebase as a Swift
    # package instead. Our own Podfile pins FirebaseCore/FirebaseMessaging
    # directly, so THOSE targets exist in both modes and prove nothing — the
    # umbrella subspecs are the discriminator. (Confirmed against the installed
    # RNFBApp.podspec / RNFBMessaging.podspec before writing this list.)
    resolved = installer.analysis_result.specifications.map(&:name)
    %w[Firebase/CoreOnly Firebase/Messaging].each do |spec|
      next if resolved.include?(spec)
      raise "[Orbital] $RNFirebaseDisableSPM is set but '#{spec}' is not in the " \
            "resolved pod specs -- react-native-firebase resolved Firebase via SPM. " \
            "See the $RNFirebaseDisableSPM comment in ios/Podfile (#667)."
    end
  end

  # Issue #667 (guard 2 of 3 — committed app project): the user project is only
  # mutated during integration, which runs AFTER post_install, so the pbxproj
  # check lives here where it is final. RNFB writes two node classes and its
  # stale-link cleanup is rescue-wrapped (warns and continues), so match both.
  # Pods.xcodeproj may legitimately carry RN's own package references; the app
  # project must carry none.
  post_integrate do |installer|
    pbxproj = File.expand_path('../OrbitalMobile.xcodeproj/project.pbxproj', installer.sandbox.root)
    if File.read(pbxproj) =~ /XCRemoteSwiftPackageReference|XCSwiftPackageProductDependency/
      raise "[Orbital] OrbitalMobile.xcodeproj gained a Swift package reference or " \
            "product dependency -- react-native-firebase SPM integration ran despite " \
            "$RNFirebaseDisableSPM. Revert the pbxproj and fix ios/Podfile (#667)."
    end
  end

end
