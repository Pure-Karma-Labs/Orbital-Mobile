# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Issue #768: RNSentry consumes sentry-cocoa as the prebuilt Sentry.xcframework
# (the @sentry/react-native >= 8.19 default). The SENTRY_USE_XCFRAMEWORK=0
# opt-out is gone -- do not export it in your shell either: >= 8.23 raises on
# it, and the "Issue #768" post_install guard below fails without the staged
# xcframework. Mechanics, version record, provenance policy and the re-check
# trigger for every @sentry/react-native bump: docs/ios-dependency-delivery.md.

# Issue #769: Firebase is a Swift package (firebase-ios-sdk), resolved by
# react-native-firebase's firebase_spm.rb, which REQUIRES dynamic frameworks
# (static + SPM hard-fails inside RNFB). The whole pod graph therefore builds
# as dynamic frameworks; there is no env override on purpose. Never re-add
# `$RNFirebaseDisableSPM` or pin Firebase pods here. The exact Firebase
# version is the `exactVersion` requirement on the firebase-ios-sdk package
# reference in OrbitalMobile.xcodeproj; Package.resolved is derived from it.
# Guards: scripts/verify-firebase-spm.rb (harness: npm run test:firebase-spm).
# Rationale, version record, provenance, bump procedure:
# docs/ios-dependency-delivery.md.
use_frameworks! :linkage => :dynamic

# ◆ Supply-chain anchor for the Swift package (security review): this literal,
# not node_modules, is what the guards compare against. Mirrored by the
# rnfb-spm-dynamic rule in scripts/check-security-invariants.mjs.
ORBITAL_FIREBASE_SPM_URL = 'https://github.com/firebase/firebase-ios-sdk.git'

target 'OrbitalMobile' do
  # Fail Release builds (incl. Product > Archive) if the vendored Rust
  # xcframework was not built with the release cargo profile. See issue #541.
  # Logic extracted to scripts/verify-rust-profile-ios.sh; unit-tested by
  # scripts/test-rust-profile-gate-ios.sh (issue #550).
  script_phase :name => '[Orbital] Verify Rust release profile',
    :script => 'exec bash "${SRCROOT}/../scripts/verify-rust-profile-ios.sh"',
    :execution_position => :before_compile,
    :always_out_of_date => '1'

  # Native crash symbolication: upload the app dSYM to Sentry after linking.
  # sentry-xcode-debug-files.sh sources with-environment.sh itself (node on
  # PATH via ios/.xcode.env), reads ios/sentry.properties (gitignored; org,
  # project, auth token), skips Debug configurations and honours
  # SENTRY_DISABLE_AUTO_UPLOAD=true (CI). Without this phase every native
  # crash arrives in Sentry as native_missing_dsym (found 2026-09-16).
  # Phase name "Upload Debug Symbols to Sentry" is the canonical string
  # upstream's sentryExpoNativeCheck.js looks for — do not rename it.
  script_phase :name => 'Upload Debug Symbols to Sentry',
    :script => '/bin/sh "${SRCROOT}/../node_modules/@sentry/react-native/scripts/sentry-xcode-debug-files.sh"',
    :execution_position => :after_compile,
    :always_out_of_date => '1'

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 rejects any target whose IPHONEOS_DEPLOYMENT_TARGET is below
    # 15.0 (an error, not the warning Xcode 26 gave). react_native_post_install
    # raises the floor on each pod's native target only; the privacy-manifest
    # resource bundles (RNImagePickerPrivacyInfo) keep their podspec's 9.0/12.0
    # and fail `xcodebuild archive` on Xcode 27. Raise them to the same floor
    # RN uses for native targets. CI cannot see this: build.yml pins the newest
    # Xcode 26.x. Note: Firebase/Google resource bundles (nanopb_Privacy,
    # GoogleUtilities_Privacy, GoogleDataTransport_Privacy, FBLPromises_Privacy)
    # left the pod graph when Firebase moved to SPM (#769); SPM package resource
    # bundles are not pod targets and never pass through this loop -- that is
    # fine, Xcode builds them at the package's own floor.
    floor = min_ios_version_supported.to_f
    installer.target_installation_results.pod_target_installation_results.each_value do |result|
      result.resource_bundle_targets.each do |bundle|
        bundle.build_configurations.each do |build_config|
          current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported if current < floor
        end
      end
    end

    # Issue #769: under dynamic frameworks each pod links on its own, so a
    # podspec that uses a symbol without declaring the pod that compiles it
    # fails with "Undefined symbols" at ITS link step. Table: pod target =>
    # [[pod directory (nil = system framework), framework name]].
    # VERIFIED rows were each found by a real link failure in the Tier-1 probe.
    # PRE-EMPTIVE rows are the dependency edges RN 0.83-stable's podspecs added
    # (diff of every RN podspec 0.82.1 -> 0.83-stable) and never failed here;
    # they are harmless extra -framework flags. Do NOT add 0.83's
    # jsinspectortracing -> jsinspectornetwork edge: 0.82 has the reverse edge
    # and Xcode reports a target cycle.
    # The PRE-EMPTIVE rows insure the one link path CI never exercises -- Release/
    # Archive on the build machine -- where a symbol that Debug happened not to
    # pull could surface; they cost nothing at build time.
    # DELETE the RN rows at the RN >= 0.83 upgrade (#311 carries the checklist
    # line); the two third-party rows are owned by the dependency-bump PRs for
    # react-native-video / react-native-fs -- drop each when its podspec
    # declares the dependency (the unmatched-key raise below makes a stale row
    # loud). Re-run the Tier-1 probe (docs/ios-dependency-delivery.md) after either.
    #
    # OrbitalSignal.podspec is regenerated byte-for-byte by ubrn on every
    # `build:ios[:release]` (ubrn.config.yaml has no `noOverwrite`). OrbitalSignal's
    # linkage settings therefore have exactly ONE legal home -- this post_install
    # hook -- never the podspec. The merge-gate no-op assertion covers it.
    missing_links = {
      # VERIFIED (link failure in the probe)
      'React-webperformancenativemodule' => [['React-cxxreact', 'cxxreact']],          # ReactMarker::StartupLogger; RN 0.83 adds s.dependency "React-cxxreact"
      'React-defaultsnativemodule'       => [['React-featureflags', 'React_featureflags']], # ReactNativeFeatureFlags; RN 0.83 adds add_dependency React-featureflags
      'react-native-video'               => [['React-CoreModules', 'CoreModules']],      # RCTEventDispatcher class lives in React-CoreModules
      # PRE-EMPTIVE (from the 0.83 podspec diff; never failed here)
      'React-CoreModules'                => [['React-featureflags', 'React_featureflags'], ['React-utils', 'React_utils']],
      'React-jsiexecutor'                => [['React-utils', 'React_utils']],
      'React-cxxreact'                   => [['React-utils', 'React_utils']],
      'React-jsitooling'                 => [['React-utils', 'React_utils']],
      'React-jsinspector'                => [['React-utils', 'React_utils']],
      'React-RCTRuntime'                 => [['React-utils', 'React_utils']],
      'React-jsinspectortracing'         => [['React-utils', 'React_utils'], ['React-jsi', 'jsi']],
    }
    by_name = installer.pods_project.native_targets.to_h { |t| [t.name, t] }
    missing = missing_links.keys - by_name.keys
    unless missing.empty?
      raise "[Orbital] missing_links names pod targets that do not exist: #{missing.inspect} -- " \
            "a pod was renamed or dropped; delete or fix the row rather than let it apply nothing (#769)."
    end
    missing_links.each do |name, links|
      by_name[name].build_configurations.each do |c|
        ld = Array(c.build_settings['OTHER_LDFLAGS'] || '$(inherited)').join(' ')
        fw = Array(c.build_settings['FRAMEWORK_SEARCH_PATHS'] || '$(inherited)').join(' ')
        links.each do |dir, fname|
          ld += " -framework \"#{fname}\""
          fw += " \"${PODS_CONFIGURATION_BUILD_DIR}/#{dir}\"" if dir
        end
        c.build_settings['OTHER_LDFLAGS'] = ld
        c.build_settings['FRAMEWORK_SEARCH_PATHS'] = fw
      end
    end

    # Xcode 26 Clang falsely advertises consteval support but fails to compile it.
    # Patch fmt's base.h to force-disable consteval on all Apple Clang versions.
    # Tracking: https://github.com/facebook/react-native/issues/55601
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      patched = content.gsub(
        /defined\(__apple_build_version__\) && __apple_build_version__ < \d+L/,
        'defined(__apple_build_version__)'
      )
      if patched != content
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched)
      end
    end

    # Issue #769 (guard 1 of 3 — installer state; read-only tenant, keep last
    # among mutating tenants). RNFirebaseSPM is defined by node_modules/
    # @react-native-firebase/app/firebase_spm.rb; a NameError here means
    # upstream renamed it -- re-check the whole guard. Never call rnfirebase_*
    # helpers from a hook: they mutate projects. The committed-file checks
    # (pbxproj reference, Package.resolved) run in post_integrate (guard 2).
    unless RNFirebaseSPM.active?
      raise "[Orbital] react-native-firebase did not take the SPM path -- a " \
            "$RNFirebaseDisableSPM assignment or a non-dynamic use_frameworks! " \
            "line is back in ios/Podfile (#769)."
    end
    unless RNFirebaseSPM.url == ORBITAL_FIREBASE_SPM_URL
      raise "[Orbital] @react-native-firebase/app resolves Firebase from " \
            "#{RNFirebaseSPM.url.inspect}, expected #{ORBITAL_FIREBASE_SPM_URL}. Do NOT " \
            "'fix' the Podfile literal: verify the installed react-native-firebase package " \
            "has not been tampered with (sdkVersions.ios.firebaseSpmUrl) (#769)."
    end
    resolved = installer.analysis_result.specifications.map(&:name)
    stray = resolved.select { |n| n.start_with?('Firebase', 'GoogleUtilities', 'GoogleDataTransport', 'nanopb', 'PromisesObjC') }
    unless stray.empty?
      raise "[Orbital] CocoaPods resolved #{stray.inspect} -- Firebase/Google pods must not " \
            "exist in the pod graph next to the SPM package (double module graph) (#769)."
    end

    # Issue #768: RNSentry must consume the prebuilt Sentry.xcframework through
    # the Pods/sentry-xcframeworks symlink, never the absolute ~/Library/Caches
    # path (docs/ios-dependency-delivery.md). Deliberately NOT vacuous: the
    # staged version, the link and the "$(PODS_ROOT)" search path must all
    # exist, so re-adding the opt-out (or exporting SENTRY_USE_XCFRAMEWORK=0)
    # fails here. Never call ensure_sentry_xcframework /
    # stage_sentry_xcframework_in_pods from this hook: both have side effects
    # and would make the check self-fulfilling. SENTRY_XCFRAMEWORK_STAGING_DIR
    # is defined by RNSentry's scripts/sentry_utils.rb (required by its podspec);
    # a NameError here means upstream renamed it -- re-check the whole guard.
    expected_sentry_cocoa = '9.29.0' # bump with @sentry/react-native; the docs table points here
    pods_root = installer.sandbox.root.to_s
    staging = File.join(pods_root, SENTRY_XCFRAMEWORK_STAGING_DIR)
    sentry_fix = "Unset SENTRY_USE_XCFRAMEWORK (and the deprecated SENTRY_USE_SPM) in your shell -- the " \
                 "ios/Podfile opt-out was removed in #768 -- look for a '[Sentry] Could not link' warning " \
                 "in the pod install output, then re-run pod install. See docs/ios-dependency-delivery.md (#768)."
    versions = Dir.exist?(staging) ? Dir.children(staging).reject { |d| d.start_with?('.') } : []
    unless versions == [expected_sentry_cocoa]
      raise "[Orbital] expected #{staging}/#{expected_sentry_cocoa} and nothing else, found " \
            "#{versions.inspect} -- RNSentry did not stage its xcframework, or sentry-cocoa moved " \
            "without updating expected_sentry_cocoa in ios/Podfile. If the extra entry is a previous " \
            "sentry-cocoa version (a restored ios/Pods cache), rm -rf ios/Pods/sentry-xcframeworks and " \
            "re-run pod install. #{sentry_fix}"
    end
    link = File.join(staging, expected_sentry_cocoa, 'Sentry.xcframework')
    unless File.symlink?(link) && File.file?(File.join(link, 'Info.plist'))
      raise "[Orbital] #{link} is not a symlink to a populated Sentry.xcframework -- the cache it " \
            "points at is missing or the extract was interrupted. #{sentry_fix}"
    end
    podspec_json = File.join(pods_root, 'Local Podspecs', 'RNSentry.podspec.json')
    expected_ref = "$(PODS_ROOT)/#{SENTRY_XCFRAMEWORK_STAGING_DIR}/#{expected_sentry_cocoa}/Sentry.xcframework"
    unless File.file?(podspec_json) && File.read(podspec_json).include?(expected_ref)
      raise "[Orbital] #{podspec_json} has no FRAMEWORK_SEARCH_PATHS entry for #{expected_ref} -- " \
            "RNSentry resolved without the xcframework staging path. #{sentry_fix}"
    end
    # The leak pattern and the required-file list have ONE home: the script CI
    # runs after pod install. Running it here makes the build machine run it too.
    assert_script = File.expand_path('../../scripts/assert-no-absolute-pod-paths.sh', pods_root)
    # Env passed explicitly so an exported POD_INSTALL_OUTCOME cannot downgrade this run.
    unless system({ 'POD_INSTALL_OUTCOME' => 'success' }, 'bash', assert_script, pods_root)
      raise "[Orbital] scripts/assert-no-absolute-pod-paths.sh failed (see its output above) -- an " \
            "absolute machine-specific path leaked into the pod graph. #{sentry_fix}"
    end
  end

  # Issue #769 (guard 2 of 3 — committed app project + Package.resolved).
  # Logic and fixtures: scripts/verify-firebase-spm.rb (+ test-verify-firebase-spm.sh,
  # run by ci.yml before pod install and by `npm run test:firebase-spm`).
  # RNFB writes the app-project package reference AFTER this hook returns (it
  # wraps run_podfile_post_integrate_hooks), so this checks the pbxproj AS
  # COMMITTED: a next-run tripwire. Same-run coverage: ci.yml's pbxproj diff.
  # Bootstrap (the very first install on a tree with no reference yet):
  # ORBITAL_SPM_BOOTSTRAP=1 downgrades ONLY the "reference missing" and
  # "Package.resolved missing" failures to warnings so RNFB can write the
  # reference; every other check still raises. Never set it in CI or in a
  # shell profile -- docs/ios-dependency-delivery.md §Bootstrap.
  post_integrate do |installer|
    script = File.expand_path('../../scripts/verify-firebase-spm.rb', installer.sandbox.root)
    args = ['ruby', script,
            '--pbxproj', File.expand_path('../OrbitalMobile.xcodeproj/project.pbxproj', installer.sandbox.root),
            '--resolved', File.expand_path('../OrbitalMobile.xcworkspace/xcshareddata/swiftpm/Package.resolved', installer.sandbox.root),
            '--expected-url', ORBITAL_FIREBASE_SPM_URL,
            '--expected-version', RNFirebaseSPM.version,
            '--app-target', 'OrbitalMobile']
    args << '--bootstrap' if ENV['ORBITAL_SPM_BOOTSTRAP'] == '1'
    unless system(*args)
      raise "[Orbital] scripts/verify-firebase-spm.rb failed (see its output above) (#769)."
    end
  end

end
