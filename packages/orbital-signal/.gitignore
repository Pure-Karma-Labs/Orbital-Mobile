# Binary artifacts — rebuilt locally and in CI
OrbitalSignalFramework.xcframework/
android/src/main/jniLibs/

# Provenance marker written by build:ios / build:ios:release (local only):
# profile line + the scripts/rust-input-digest.sh output. The glob also covers
# the .tmp staging file those scripts write to before the atomic mv (#813).
rust-profile-ios.txt*

# No lockfile here on purpose (removed in #798). This package is a `file:`
# dependency of the app root, so its one dependency (uniffi-bindgen-react-native)
# resolves into the ROOT package-lock.json and `ubrn` runs from the root
# node_modules/.bin. The old sub-lock was an orphan peer closure pinned at a
# different react-native than the app, installed by nothing, audited by nothing,
# and a Dependabot alert surface. Never run `npm install` in this directory.
package-lock.json
node_modules/
