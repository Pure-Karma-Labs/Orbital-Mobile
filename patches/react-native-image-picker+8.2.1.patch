+// ORBITAL-PATCH(#971): the whole callback discipline lives in these three
+// methods.
+//
+//   * takePendingContext        — unconditional read-and-clear. Only two
+//                                 callers, both in launchImagePicker: on main,
+//                                 where the context either predates any picker
+//                                 or is being retired by a new launch.
+//   * takeContextForPicker:     — read-and-clear ONLY if `picker` is the view
+//                                 controller that owns the pending context. A
+//                                 nil key never matches. This is what makes a
+//                                 stale picker's event a no-op instead of a
+//                                 double call.
+//   * invokeCallbackForPicker:response:
+//                               — hop to main if needed, take, and call the
+//                                 callback if a context was taken.
+//
+// Callback state is touched on the main queue only. Because a take clears the
+// context, a callback can be invoked at most once per launch, whatever order
+// the picker's events arrive in.
+
+- (OrbitalPickerContext *)takePendingContext
+{
+    NSAssert([NSThread isMainThread], @"ORBITAL-PATCH(#971): picker callback state is main-queue-only");
+    OrbitalPickerContext *context = self.pendingContext;
+    self.pendingContext = nil;
+    return context;
+}
+
+- (OrbitalPickerContext *)takeContextForPicker:(UIViewController *)picker
+{
+    NSAssert([NSThread isMainThread], @"ORBITAL-PATCH(#971): picker callback state is main-queue-only");
+    if (picker == nil) {
+        return nil;
+    }
+    if (self.pendingContext == nil || self.pendingContext.picker != picker) {
+        return nil;
+    }
+    return [self takePendingContext];
+}
+
+- (void)invokeCallbackForPicker:(UIViewController *)picker response:(NSDictionary *)response
+{
+    if (![NSThread isMainThread]) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            [self invokeCallbackForPicker:picker response:response];
+        });
+        return;
+    }
+    OrbitalPickerContext *context = [self takeContextForPicker:picker];
+    if (context.callback != nil) {
+        context.callback(@[response]);
+    }
+}
